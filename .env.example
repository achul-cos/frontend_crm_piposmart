# ============================================================
# Konfigurasi Frontend CRM Piposmart
# Salin berkas ini menjadi .env.local lalu sesuaikan nilainya.
# ============================================================

# Dipakai HANYA di sisi server (Route Handler app/api/auth/*).
# Tidak diberi prefix NEXT_PUBLIC_ agar tidak ikut terbundel ke browser.
BACKEND_API_URL=http://localhost:8080/api/v1

# Dipakai browser untuk memanggil endpoint data secara langsung.
# Nilainya boleh sama dengan BACKEND_API_URL; sengaja dipisah supaya
# jelas variabel mana yang terekspos ke publik.
NEXT_PUBLIC_BACKEND_API_URL=http://localhost:8080/api/v1

# Nama cookie httpOnly tempat refresh token disimpan oleh Next.js.
AUTH_REFRESH_COOKIE=piposmart_rt
